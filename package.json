{
  "name": "yaml-spec-blocks",
  "displayName": "YAML Spec Blocks",
  "description": "Cursor-aware block suggestions for dbt model YAML, filled from the model you're editing, plus cross-reference checks.",
  "version": "0.2.0",
  "publisher": "skouzini",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skouzini/yaml-spec-blocks"
  },
  "bugs": {
    "url": "https://github.com/skouzini/yaml-spec-blocks/issues"
  },
  "homepage": "https://github.com/skouzini/yaml-spec-blocks#readme",
  "sponsor": {
    "url": "https://ko-fi.com/skouzini"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Snippets",
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --minify --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "tsx test/run.ts && tsx test/insert.ts",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.85",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "contributes": {
    "commands": [
      {
        "command": "yamlSpecBlocks.insertBlock",
        "title": "YAML Spec Blocks: Insert Block Here"
      },
      {
        "command": "yamlSpecBlocks.reloadSchema",
        "title": "YAML Spec Blocks: Reload Schema"
      }
    ],
    "keybindings": [
      {
        "command": "yamlSpecBlocks.insertBlock",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && editorLangId == yaml"
      }
    ],
    "configuration": {
      "title": "YAML Spec Blocks",
      "properties": {
        "yamlSpecBlocks.schemaPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Schema file (YAML or JSON), absolute or relative to the workspace folder. Empty: `schemas/model_spec.schema.yaml` (or `.json`) in the workspace, else the schema bundled with the extension."
        },
        "yamlSpecBlocks.include": {
          "type": "string",
          "default": "**/models/**/*.{yml,yaml}",
          "description": "Glob of the model YAML files YAML Spec Blocks works in."
        },
        "yamlSpecBlocks.suggestOnNewLine": {
          "type": "boolean",
          "default": true,
          "description": "Open suggestions automatically when Enter lands on a line where blocks or keys fit."
        },
        "yamlSpecBlocks.lint": {
          "type": "boolean",
          "default": true,
          "description": "Warn about cross-reference problems (definitions vs sources, completes targets)."
        },
        "yamlSpecBlocks.syncJsonSchema": {
          "type": "boolean",
          "default": true,
          "description": "When the schema is YAML, keep a .json copy beside it (for the Red Hat YAML extension's validation)."
        }
      }
    }
  }
}
